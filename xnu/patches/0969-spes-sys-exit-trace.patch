--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -51,20 +51,81 @@
  * asked for and the result (1500 lines at most). Settings > General > About crashed on a volume size that
  * came back empty.
  */
+static char sweet_sys_names[64];
+static int sweet_sys_loaded;
+
+/* true if the process name is in boot-arg sweetsys=NAME[,NAME] */
+bool sweet_sys_match(const char *comm);
+bool
+sweet_sys_match(const char *comm)
+{
+	if (!sweet_sys_loaded) {
+		if (!PE_parse_boot_argn("sweetsys", sweet_sys_names, sizeof(sweet_sys_names))) {
+			sweet_sys_names[0] = 0;
+		}
+		sweet_sys_loaded = 1;
+	}
+	if (sweet_sys_names[0] == 0) {
+		return false;
+	}
+	size_t len = strnlen(comm, MAXCOMLEN);
+	for (const char *w = sweet_sys_names; *w;) {
+		const char *e = w;
+		while (*e && *e != ',') {
+			e++;
+		}
+		if ((size_t)(e - w) == len && len != 0 && strncmp(w, comm, len) == 0) {
+			return true;
+		}
+		w = *e ? e + 1 : e;
+	}
+	return false;
+}
+
+/* The last 64 system calls of the traced process, dumped when it exits. */
+#define SWEET_RING 64
+static struct { uint16_t code; int16_t err; } sweet_ring[SWEET_RING];
+static unsigned sweet_ring_n;
+static int sweet_ring_pid;
+
+void sweet_sys_ring_dump(struct proc *proc);
+void
+sweet_sys_ring_dump(struct proc *proc)
+{
+	char line[200];
+	unsigned n = sweet_ring_n < SWEET_RING ? sweet_ring_n : SWEET_RING;
+	if (sweet_ring_pid != proc_getpid(proc)) {
+		return;
+	}
+	printf("SWEET EXIT: last %u system calls of %s[%d] (code/error), oldest first:\n", n, proc->p_comm, proc_getpid(proc));
+	int l = 0;
+	for (unsigned i = 0; i < n; i++) {
+		unsigned k = (sweet_ring_n - n + i) % SWEET_RING;
+		l += snprintf(line + l, sizeof(line) - l, " %u/%d", sweet_ring[k].code, sweet_ring[k].err);
+		if (l > (int)sizeof(line) - 24 || i == n - 1) {
+			printf("SWEET EXIT:%s\n", line);
+			l = 0;
+		}
+	}
+}
