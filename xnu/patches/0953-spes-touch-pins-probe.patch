@@ -138,7 +143,14 @@
 static vm_offset_t
 touch_tile(unsigned pin)
 {
-	return pin == TOUCH_PIN_AVDD ? st.east : st.west;
+	/* spes (khaje pinctrl): GPIO 36 EAST, GPIO 98..112 SOUTH, the rest WEST. */
+	if (pin == 36u) {
+		return st.east;
+	}
+	if (pin >= 98u) {
+		return st.south;
+	}
