From: Claude <noreply@anthropic.com>
Subject: [PATCH] spes: AppleKeyStore lock-state flags follow the software passcode

diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index 532652c..b46fac3 100644
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -178,6 +178,23 @@ sweet_aks_secret_matches(const uint8_t *s, uint32_t len)
 	return len == g_pass_len && memcmp(s, g_pass, len) == 0;
 }
 
+/*
+ * AppleKeyStore lock-state flags (from memory of MobileKeyBag's MKBGetDeviceLockState, to be verified on the phone):
+ * 1 = locked, 2 = no passcode set, 4 = unlocked since boot. Settings shows "Turn Passcode On" and SpringBoard skips the
+ * lock screen prompt when 2 is set; with a passcode the state is 4 (unlocked) or 5 (locked).
+ */
+static uint32_t
+sweet_aks_lock_flags(void)
+{
+	uint32_t f = SWEET_AKS_LOCK_STATE;
+	if (!g_pass_set) {
+		f |= 2;
+	} else if (g_locked) {
+		f |= 1;
+	}
+	return f;
+}
+
 /*
  * Device state (selector 17): a DER SET of key/INTEGER pairs that libaks
  * decode_extended_state reads: ss state, sls lock state (MKBGetDeviceLockState:
@@ -191,7 +208,7 @@ sweet_aks_device_state(IOExternalMethodArguments *args)
 		const char *key;
 		uint8_t value;
 	} fields[] = {
-		{ "ss", SWEET_AKS_LOCK_STATE }, { "sls", g_locked }, { "sb", 0 }, { "sfa", 0 },
+		{ "ss", (uint8_t)sweet_aks_lock_flags() }, { "sls", g_locked }, { "sb", 0 }, { "sfa", 0 },
 		{ "sgs", 0 }, { "sas", 0 }, { "sgpe", 0 }, { "srcd", 0 },
 	};
 	uint8_t buf[128];
@@ -322,7 +339,7 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 			ret = kIOReturnBadArgument;
 			break;
 		}
-		args->scalarOutput[0] = SWEET_AKS_LOCK_STATE;
+		args->scalarOutput[0] = sweet_aks_lock_flags();
 		args->scalarOutputCount = 1;
 		break;
 	case kAKSNotifyStateIsSet:
